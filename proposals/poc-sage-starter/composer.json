{
  "name": "roots/bedrock",
  "type": "project",
  "description": "WordPress Boilerplate with Bedrock + Sage",
  "require": {
    "php": ">=8.1",
    "roots/bedrock": ">=2.0",
    "roots/wordpress": ">=6.4",
    "roots/wp-config": "1.0.0",
    "roots/wp-password-bcrypt": "1.2.0",
    "wpackagist-theme/sage": ">=10.8",
    "wpackagist-plugin/advanced-custom-fields": ">=6.2",
    "wpackagist-plugin/carbon-fields": ">=3.6",
    "wpackagist-plugin/wp-mail-smtp": ">=4.0",
    "vlucas/phpdotenv": "^5.6",
    "oscarotero/env": "^2.1",
    "squizlabs/php_codesniffer": "^3.7"
  },
  "require-dev": {
    "roots/wordpress-no-content": "^6.4",
    "wpackagist-plugin/query-monitor": "^3.15",
    "wpackagist-plugin/debug-bar": "^1.1"
  },
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "post-install-cmd": [
      "Roots\\Bedrock\\ComposerScripts::addSalts"
    ],
    "test": [
      "phpcs --standard=WordPress web/app/themes/sage/app/"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  }
}
