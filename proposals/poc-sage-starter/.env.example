# Environment Configuration
# Copy this to .env and fill in your values

# WordPress URLs
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080/wp

# Database
DB_NAME=sage
DB_USER=sage
DB_PASSWORD=sage_password
DB_HOST=db
DB_PORT=3307

# WordPress Authentication Salts (generate with: wp config salts)
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# WordPress Environment
WP_ENVIRONMENT_TYPE=development
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false
DISALLOW_FILE_EDIT=true

# Google Maps API Key (for property map blocks)
GOOGLE_MAPS_API_KEY=

# SMTP / Mail
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Sage Site

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Docker Ports
NGINX_PORT=8080
DB_PORT=3307
PMA_PORT=8081
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
