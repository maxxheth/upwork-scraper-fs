# FlareSolverr
FLARESOLVERR_URL=http://localhost:8193

# Proxy file (one proxy URL per line, format: http://user:pass@host:port)
PROXY_FILE=./proxies.txt

# Output
OUTPUT_DIR=./output

# UpWork UI Inspector / Scrapling Session
UPWORK_USER_DATA_DIR=./.session/chrome_profile
UPWORK_STORAGE_STATE=./.session/storage_state.json
# Pinned proxy index (0-based) from proxies.txt or explicit URL for consistent IP
UPWORK_SESSION_PROXY_INDEX=0
UPWORK_SESSION_PROXY_URL=
# Optional CDP URL to attach to an already-running Chrome
UPWORK_CDP_URL=
UI_REPORT_DIR=./output/ui_reports
